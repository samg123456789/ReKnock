# Copy to .env.local and fill in. Never commit real values.
# Dev/Preview: use TEST-mode keys only. Production keys live in Vercel Production env only.

# App
APP_URL=                              # e.g. http://localhost:3000 (local) or the deploy URL

# Supabase (dev project: reknock-dev, ref hgmjkugxrsxxarjdgevc)
NEXT_PUBLIC_SUPABASE_URL=             # Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Project Settings > API > anon public key
SUPABASE_SERVICE_ROLE_KEY=           # Project Settings > API > service_role key (server only, secret)

# Stripe (TEST mode on dev)
STRIPE_SECRET_KEY=                    # sk_test_... on dev
STRIPE_WEBHOOK_SECRET=                # whsec_... for the endpoint pointing at this deploy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_... on dev
# Prices are created by scripts/stripe-setup.mjs and resolved at runtime by
# lookup_key, so there are no price ids to set here.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DEV_SMS_ALLOWLIST=                    # comma-separated E.164 numbers; dev refuses to send to anything else

# Anthropic
ANTHROPIC_API_KEY=

# Resend (transactional + inbound email)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Number provisioning: real Twilio purchases only happen when this is "true"
# on production. Anywhere else, claiming a number is simulated (no charge).
ALLOW_NUMBER_PURCHASE=
